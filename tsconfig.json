{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // No "baseUrl": deprecated in TypeScript 6 and removed in 7. Since TS 5,
    // "paths" entries resolve relative to this file's directory already.
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"]
}
